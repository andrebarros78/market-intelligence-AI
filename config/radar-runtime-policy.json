{
  "schema_version": 2,
  "component": "market-intelligence-radar",
  "classification": "sovereign_core",
  "lifecycle": "always_on",
  "availability_target": "24x7_continuous",
  "operational_horizon_years": 5000,
  "normal_expiration_allowed": false,
  "operator_disable_allowed": false,
  "automatic_shutdown_allowed": false,
  "safety_emergency_stop_allowed": true,
  "restart_policy": "always",
  "watchdog_required": true,
  "self_recovery_required": true,
  "startup_required": true,
  "skills_registry_required": true,
  "skills_registry_must_be_nonempty": true,
  "observation_scope": {
    "mode": "all_authorized_observable_signals",
    "continuous_collection": true,
    "continuous_investigation": true,
    "continuous_learning_from_validated_evidence": true,
    "include_business_events": true,
    "include_channel_telemetry": true,
    "include_schema_changes": true,
    "include_latency_rate_limit_retry_signals": true,
    "include_market_competition_signals_when_authorized": true,
    "include_historical_pattern_analysis": true,
    "secret_or_unauthorized_access": false,
    "include_declared_signals": true,
    "include_undeclared_but_observable_signals": true,
    "include_derived_signals": true,
    "include_absence_and_silence_signals": true,
    "include_cross_signal_correlations": true,
    "include_behavioral_drift": true,
    "continuous_observation": true
  },
  "read_only_marketplace_policy": {
    "MI_READ_ONLY": true,
    "MI_ALLOW_MARKETPLACE_WRITES": false
  },
  "roles": [
    "continuous_ingestion_observer",
    "evidence_validator",
    "marketplace_state_monitor",
    "channel_telemetry_monitor",
    "schema_change_detector",
    "anomaly_detector",
    "regime_change_detector",
    "investigator",
    "historical_pattern_analyst",
    "market_competition_analyst",
    "trend_analyst",
    "alert_generator",
    "analytical_explainer"
  ],
  "knowledge_rule": {
    "raw_is_fact": false,
    "hypothesis_is_fact": false,
    "validated_evidence_required_for_permanent_fact": true
  },
  "llm_dependency": {
    "runtime_requires_llm": false,
    "radar_continues_if_llm_unavailable": true,
    "llms_are_optional_analytical_accelerators": true
  },
  "effectiveness_objectives": {
    "maximize_observable_signal_coverage": true,
    "maintain_complete_history": true,
    "detect_regime_changes": true,
    "correlate_business_and_channel_signals": true,
    "measure_false_positive_rate": true,
    "measure_detection_latency": true,
    "measure_evidence_completeness": true,
    "measure_recovery_time": true,
    "benchmark_against_llm_only_analysis": true
  },
  "architecture_scope": "universal_multimarketplace",
  "first_active_marketplace": "mercadolivre",
  "target_marketplaces": [
    "mercadolivre",
    "amazon",
    "shopee",
    "tiktok_shop",
    "shein",
    "magalu",
    "americanas",
    "carrefour",
    "aliexpress",
    "ebay",
    "walmart",
    "other_adapters"
  ]
}
